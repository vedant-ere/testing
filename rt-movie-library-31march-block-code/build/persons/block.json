{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rt-movie-library/persons",
  "version": "1.0.0",
  "title": "Persons",
  "category": "widgets",
  "icon": "groups",
  "description": "Display a filterable list of persons with career information.",
  "keywords": [
    "persons",
    "people",
    "rt-movie-library"
  ],
  "textdomain": "rt-movie-library",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "count": {
      "type": "integer",
      "default": 6
    },
    "careerId": {
      "type": "integer",
      "default": 0
    }
  },
  "editorScript": "file:./index.js"
}