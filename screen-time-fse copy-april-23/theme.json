		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": true,
			"spacingSizes": [
				{
					"name": "Space 2XS (8–10px)",
					"size": "clamp(0.5rem, 0.46875rem + 0.125vw, 0.625rem)",
					"slug": "2xs"
				},
				{
					"name": "Space XS (12–16px)",
					"size": "clamp(0.75rem, 0.6875rem + 0.25vw, 1rem)",
					"slug": "xs"
				},
				{
					"name": "Space SM (16–24px)",
					"size": "clamp(1rem, 0.875rem + 0.5vw, 1.5rem)",
					"slug": "sm"
				},
				{
					"name": "Space MD (24–40px)",
					"size": "clamp(1.5rem, 1.25rem + 1vw, 2.5rem)",
					"slug": "md"
				},
				{
					"name": "Space LG (32–48px)",
					"size": "clamp(2rem, 1.75rem + 1vw, 3rem)",
					"slug": "lg"
				},
				{
					"name": "Space XL (40–64px)",
					"size": "clamp(2.5rem, 2.125rem + 1.5vw, 4rem)",
					"slug": "xl"
				}
			],
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
