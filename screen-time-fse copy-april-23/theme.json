	"styles": {
		"blocks": {
			"core/post-template": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--big-shoulders)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--big-shoulders)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--page-bg)",
			"text": "var(--wp--preset--color--text-primary)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-light)"
					}
				},
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--big-shoulders)",
					"fontWeight": "300",
					"lineHeight": "1.04"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--big-shoulders)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heebo)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--big-shoulders)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"textTransform": "capitalize"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--sm)",
			"padding": {
				"bottom": "0",
				"left": "0",
				"right": "0",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--heebo)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "screen-time-header-template-part",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "screen-time-footer-template-part",
			"title": "Footer"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Quick Links Sidebar"
		}
	],
	"version": 3
}